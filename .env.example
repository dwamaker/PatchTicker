# Copy to .env (git ignores it) and fill in. Never commit .env.
# Folder the local store writes into; web/data lets the page read it directly.
# Leave it empty to write to the R2 bucket below instead (live collectors).
VR_STORE_DIR=
# R2 bucket (S3 API). Endpoint: https://<account id>.r2.cloudflarestorage.com
# Key: an R2 API token with Object Read & Write on this bucket only.
VR_R2_ENDPOINT=
VR_R2_BUCKET=
VR_R2_ACCESS_KEY_ID=
VR_R2_SECRET_ACCESS_KEY=
# Optional SQLite file that gets a copy of every document written (compose.yaml sets it to /backup/store.sqlite).
# VR_BACKUP_DB=
# Name written into status.json, e.g. laptop, oracle-main, 104-standby.
VR_COLLECTOR_ID=
# Contact sent in the User-Agent so sources can reach us (URL or email).
VR_CONTACT=
# Optional free NVD API key (https://nvd.nist.gov/developers/request-an-api-key): 50 requests per 30 s instead of 5.
VR_NVD_API_KEY=
# Optional GitHub token with no scopes; raises GitHub search from 10 to 30 requests a minute.
VR_GITHUB_TOKEN=
# Optional comma-separated curator RSS feeds; leave the line out for the defaults (tl;dr sec,
# Risky Business News), or set it empty for none.
# VR_CURATOR_FEEDS=
# Claude API key for Summaries (this box's own key). Leave empty for Briefs only.
ANTHROPIC_API_KEY=
