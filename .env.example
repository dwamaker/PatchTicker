# Copy to .env (git ignores it) and fill in. Never commit .env.
# Folder the local store writes into; web/data lets the page read it directly.
VR_STORE_DIR=
# Name written into status.json, e.g. laptop, oracle-main, 104-standby.
VR_COLLECTOR_ID=
# Contact sent in the User-Agent so sources can reach us (URL or email).
VR_CONTACT=
# Optional free NVD API key (https://nvd.nist.gov/developers/request-an-api-key): 50 requests per 30 s instead of 5.
VR_NVD_API_KEY=
# Optional GitHub token with no scopes; raises GitHub search from 10 to 30 requests a minute.
VR_GITHUB_TOKEN=
